# Copiá este archivo como .env y pegá tu API key real.
# El archivo .env NUNCA se sube a git (está en .gitignore).

ANTHROPIC_API_KEY=sk-ant-api03-TU-KEY-ACA

# --- Integración Eva -> Sistema Coronel Sur (opcional) ---
# URL del sistema de gestión; si está definida, cada pedido confirmado
# por Eva se crea automáticamente como presupuesto.
# CORONEL_URL=http://127.0.0.1:8000
# AGENTE_TOKEN=eva-coronel-2026

# --- Clave del sistema Coronel Sur (cambiar antes de ponerlo online) ---
# CORONEL_CLAVE=coronel2026

# --- Límites anti-abuso de Eva (opcionales, estos son los defaults) ---
# LIMITE_POR_NUMERO_HORA=20
# LIMITE_GLOBAL_DIA=400
# Tu número para recibir la alerta si se alcanza el tope global:
# ALERTA_WHATSAPP=5492954525928
# Hora del resumen diario de Eva al dueño (0-23, default 21):
# RESUMEN_HORA=21

# --- WhatsApp OFICIAL de Meta para Eva (migración futura, ver MANUAL 8b) ---
# WA_TOKEN=
# WA_PHONE_ID=
# WA_VERIFY_TOKEN=
# WA_APP_SECRET=   (App Secret de Meta: valida la firma del webhook)

# --- Mercado Pago: link de pago en los pedidos de Eva (opcional) ---
# MP_ACCESS_TOKEN=APP_USR-...

# --- Tienda online pública (opcional) ---
# WA_TIENDA=5492954864154
# NEGOCIO_NOMBRE=Dist Coronel Sur
