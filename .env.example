# Copiá este archivo como .env y completá los valores. El .env NO se sube al repositorio.

# desarrollo | produccion  (en produccion las cookies son Secure y SECRET_KEY es obligatoria)
ENTORNO=desarrollo

# Clave larga y aleatoria (mínimo 32 caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ruta de la base de datos y de la carpeta de respaldos (opcionales).
# DB_PATH=backend/db/coronel_sur.db
# BACKUP_DIR=backend/db/respaldos

# Duración de la sesión en horas.
SESION_HORAS=12
