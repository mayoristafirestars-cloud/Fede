# ─── Credenciales de proveedores de precios ────────────────────────────────
# Copiá este archivo a `.env` y completá las claves que tengas.
# El buscador usa todos los proveedores que encuentre configurados y combina
# los resultados; si no hay ninguno, cae al proveedor `demo` (datos sintéticos).

# Amadeus Self-Service — https://developers.amadeus.com
# Registro gratuito, sin tarjeta. Da acceso a Flight Offers Search.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" usa datos limitados y cacheados; "produccion" requiere pedir el alta.
AMADEUS_ENTORNO=test

# Travelpayouts / Aviasales — https://www.travelpayouts.com
# Token de afiliado. Buena cobertura de precios históricos y calendario.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# ─── Contexto argentino ────────────────────────────────────────────────────
# Tipo de cambio a usar para convertir precios en USD a pesos.
# Dejalo vacío para que el buscador lo consulte online.
USD_ARS=

# ─── Preferencias por defecto del buscador ─────────────────────────────────
# Tope de llamadas HTTP por búsqueda, para no fundir la cuota gratuita.
PRESUPUESTO_REQUESTS=40
