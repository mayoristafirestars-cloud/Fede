# ─── Credenciales de proveedores de precios ────────────────────────────────
# Copiá este archivo a `.env` y completá las claves que tengas. El buscador
# usa todos los proveedores que encuentre configurados y combina los
# resultados. Sin ninguno, cae al proveedor `demo` (datos sintéticos) y lo
# avisa en la salida.

# ── SerpApi (PRIMARIO) ──
# https://serpapi.com/manage-api-key — 250 búsquedas por mes gratis, SIN tarjeta.
# Es el único proveedor de acceso abierto que ve Flybondi y JetSmart, que no
# publican en ningún GDS. Sin él, una búsqueda de cabotaje argentino se pierde
# sistemáticamente las tarifas más baratas.
SERPAPI_KEY=

# Mercado e idioma con los que se consulta Google Flights. `ar` + `es` hace
# que los precios reflejen el punto de venta argentino.
SERPAPI_GL=ar
SERPAPI_HL=es
# La búsqueda profunda es más precisa pero más lenta.
SERPAPI_DEEP_SEARCH=true

# ── Travelpayouts (SECUNDARIO) ──
# https://www.travelpayouts.com — token de afiliado, gratis y sin tope de
# requests. No se usa para cotizar (sus precios son caché de hasta una semana)
# sino para barrer el calendario y decidir qué fechas vale la pena consultar
# con SerpApi. Es lo que evita fundir la cuota gratuita en una sola búsqueda.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# ─── Contexto argentino ────────────────────────────────────────────────────
# Tipo de cambio para convertir precios en dólares a pesos. Dejalo vacío y se
# consulta online (dolarapi.com), con caché de 6 horas. Fijalo a mano para
# trabajar sin conexión o para reproducir un análisis viejo.
USD_ARS=

# ─── Preferencias por defecto ──────────────────────────────────────────────
# Tope de llamadas a las APIs por búsqueda, para no quemar la cuota.
PRESUPUESTO_REQUESTS=40
