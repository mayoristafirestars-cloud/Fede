# Lo que deja al lado el ejemplo 8 cuando se lo corre (su memoria y su bitácora): es de cada
# computadora, no del proyecto.
ejemplos/*.memoria.json
ejemplos/*.memoria.json.tmp
ejemplos/*.bitacora.txt
ejemplos/*.bitacora.txt.tmp
# El registro de errores de uso (lo arma Mate solo, al lado de mate.py): es de cada
# computadora y no se sube nunca.
errores_de_uso.txt
errores_de_uso.txt.tmp
# Lo que anota el ejemplo 10 cuando se lo corre (las consultas que atendió).
ejemplos/consultas_atendidas.txt
ejemplos/consultas_atendidas.txt.tmp
# Lo que deja el curso cuando se corren sus clases (memoria, bitácora, lo anotado) y el
# archivo de práctica de quien lo hace: es de cada computadora.
curso/*.memoria.json
curso/*.memoria.json.tmp
curso/*.memoria.rota.json
curso/*.bitacora.txt
curso/*.bitacora.txt.tmp
curso/consultas_atendidas.txt
curso/consultas_atendidas.txt.tmp
curso/practica.mate
