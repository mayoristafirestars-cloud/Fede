# =========================================================
# Meta (WhatsApp Cloud API + Instagram Messaging)
# =========================================================
# Token de acceso de la app de Meta (largo, con permisos
# whatsapp_business_messaging, whatsapp_business_management,
# instagram_basic, instagram_manage_messages, pages_messaging).
META_ACCESS_TOKEN=

# Token que vos inventás. Meta lo manda en el GET del webhook
# para verificar que sos el dueño. Tiene que coincidir con el
# que cargues en el panel de Meta.
META_VERIFY_TOKEN=cambiá-esto-por-algo-secreto

# App Secret de la app de Meta (sirve para validar firma X-Hub).
META_APP_SECRET=

# Phone Number ID de WhatsApp Business (lo ves en el panel de
# WhatsApp > API Setup). NO es el número, es el ID numérico.
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta profesional de Instagram conectada a la página.
INSTAGRAM_ACCOUNT_ID=

# =========================================================
# Anthropic (Claude — cerebro de las respuestas)
# =========================================================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# =========================================================
# OpenAI (sólo para transcribir audios con Whisper)
# =========================================================
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# =========================================================
# Google Sheets (planilla de precios)
# =========================================================
# Pegá acá TODO el contenido del JSON de la service account
# de Google (en una sola línea o como string). Alternativa:
# GOOGLE_SERVICE_ACCOUNT_FILE con la ruta a un archivo .json.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ID del Google Sheet (lo sacás de la URL:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit )
GOOGLE_SHEET_ID=

# Nombre de la pestaña con los precios.
GOOGLE_SHEET_TAB=Precios

# Cada cuántos segundos refrescar la planilla en memoria.
SHEET_CACHE_SECONDS=300

# =========================================================
# Negocio
# =========================================================
BUSINESS_NAME=Mi Negocio
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# Ruta a la base SQLite donde se guardan las conversaciones.
CONVERSATIONS_DB=data/conversations.db

# Puerto del servidor (Render lo setea automático).
PORT=8000
